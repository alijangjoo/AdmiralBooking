{
  "ConnectionStrings": {
    "CommandDb": "Server=(localdb)\\mssqllocaldb;Database=AdmiralBooking;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "QueryDb": "Server=(localdb)\\mssqllocaldb;Database=AdmiralBooking;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Outbox": {
    "SimulatePublishFailure": false,
    "PublisherIntervalSeconds": 2,
    "BatchSize": 20,
    "MaxAttempts": 8,
    "RetryDelaySeconds": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
